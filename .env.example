# 개발 서버가 /api를 중계할 블로그 주소 (끝에 슬래시 없이, 서버 측 전용)
BLOG_API_PROXY_TARGET=

# Gemini API 키 (서버 측 전용, VITE_ 접두사 금지). 개발 서버 프록시가 헤더로만 붙인다
GEMINI_API_KEY=

# 배포 시 블로그 API 주소 (끝에 슬래시 없이). 비우면 상대 경로(/api)를 사용
VITE_BLOG_API_URL=

# 개발 서버가 /server-api를 중계할 자체 서버(server/) 주소 (끝에 슬래시 없이, 서버 측 전용)
SERVER_API_PROXY_TARGET=

# 배포 시 자체 서버 주소 (끝에 슬래시 없이). 개발 중에는 비워 둔다(비우면 /server-api 프록시를 사용)
VITE_SERVER_API_URL=
