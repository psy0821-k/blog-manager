// 도메인 모델은 이후 이슈에서 추가한다. 연결 문자열은 prisma.config.ts(DIRECT_URL)와 앱 코드(DATABASE_URL)에서 다룬다.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdeaType {
  PROJECT
  LAB
  DEV_LOG
}

enum IdeaStatus {
  todo
  doing
  done
}

model Idea {
  id        String     @id @default(uuid())
  title     String
  memo      String     @default("")
  type      IdeaType
  status    IdeaStatus @default(todo)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("ideas")
}
